",\"keyNotRevealedAgain\":\"For security, its secret cannot be shown again. Use the copy you saved, or create a replacement from API keys.\",\"tryPlayground\":\"Try a Riyadh rentals request in the playground\",\"playgroundLimitations\":\"You choose when to run it. Requests use plan units, results depend on current coverage, and prices are asking prices—not completed transactions or valuations.\",\"replaceKey\":\"Create a replacement key\",\"continue\":\"Continue\",\"title\":\"Create your API account\",\"description\":\"Free plan: listings search, 30 units a minute, 250 a month. No card needed.\",\"orgName\":\"Organization name\",\"orgNameHint\":\"Your company, or your own name.\",\"website\":\"Website\",\"optional\":\"Optional.\",\"category\":\"What are you building?\",\"chooseOne\":\"Choose one\",\"tellMore\":\"Tell us a little more\",\"tellMoreHint\":\"What you'll use the data for. At least 10 characters.\",\"volume\":\"Expected volume\",\"terms\":\"I agree to the \u003cterms\u003eAPI terms of use\u003c/terms\u003e, including not reselling the data or building a competing product with it.\",\"createAccount\":\"Create account\",\"signedInAs\":\"Signed in as \u003cemail\u003e\u003c/email\u003e.\",\"signOut\":\"Sign out\"},\"consent\":{\"title\":\"Allow \u003cclient\u003e\u003c/client\u003e to use Kite?\",\"organizationUsage\":\"Searches count toward \u003corganization\u003e\u003c/organization\u003e and appear in its usage.\",\"onlyIfStarted\":\"Only allow this if you started the connection yourself.\",\"abilities\":\"\u003cclient\u003e\u003c/client\u003e will be able to:\",\"searchScope\":\"Search listings, market statistics and development projects\",\"offlineScope\":\"Stay connected until you disconnect it\",\"identityScope\":\"See your name and email address\",\"readOnly\":\"Read-only: it can't change anything, create API keys or manage the workspace.\",\"clientConnects\":\"\u003cclient\u003e\u003c/client\u003e (\u003curi\u003e\u003c/uri\u003e) connects to \u003cresource\u003e\u003c/resource\u003e.\",\"connects\":\"It connects to \u003cresource\u003e\u003c/resource\u003e.\",\"deny\":\"Deny\",\"allow\":\"Allow\",\"connecting\":\"Connecting…\",\"authorizationFailed\":\"Authorization failed\",\"missingRedirect\":\"Authorization did not return a redirect\",\"tryAgain\":\"Authorization failed. Please try again.\"},\"workspace\":{\"selectFailed\":\"Could not select the workspace\",\"continueFailed\":\"Could not continue connection\",\"connectionFailed\":\"Connection failed. Please try again.\",\"createFailed\":\"Couldn't create the workspace.\",\"cancelFailed\":\"Could not cancel connection\",\"connectingWith\":\"Connecting with \u003corganization\u003e\u003c/organization\u003e…\",\"createTitle\":\"Create your Kite workspace\",\"createDescription\":\"\u003cclient\u003e\u003c/client\u003e will search listings and market data through it. It's free, no card needed, and you can invite teammates or upgrade later.\",\"name\":\"Workspace name\",\"terms\":\"I agree to the \u003cterms\u003eterms of use\u003c/terms\u003e\",\"createContinue\":\"Create and continue\",\"chooseTitle\":\"Which workspace should \u003cclient\u003e\u003c/client\u003e use?\",\"chooseDescription\":\"Its searches count toward that workspace's plan and appear in its usage. It can't manage the workspace.\",\"workspaces\":\"Your workspaces\",\"joinTitle\":\"Join \u003corganization\u003e\u003c/organization\u003e\",\"joinDescription\":\"The owner allows people with a verified email at \u003cdomain\u003e\u003c/domain\u003e to join this workspace.\",\"memberAccess\":\"You'll join as a member, with access to the dashboard and shared API usage. You won't be able to manage keys, members or billing.\",\"joinContinue\":\"Join and continue\",\"joining\":\"Joining…\",\"companyExistsTitle\":\"Your company already has a workspace\",\"requestDescription\":\"Someone at \u003cdomain\u003e\u003c/domain\u003e already created a Free workspace. You need owner approval or an invitation to join.\",\"requestHelp\":\"Request access as a member. Only a workspace owner can approve it. You won't be able to manage keys, members or billing.\",\"requestJoin\":\"Request to join\",\"requesting\":\"Sending request…\",\"requestPending\":\"Your request is waiting for a workspace owner's approval. You don't have access yet. Check status after the owner reviews it.\",\"checkStatus\":\"Check status\",\"checkingStatus\":\"Checking status…\",\"requestRejected\":\"Your request was declined. Ask your company's workspace owner or admin to invite your email address from the Members page instead.\",\"requestApproved\":\"Your request was approved. Check status to continue with your workspace.\",\"inviteOnlyDescription\":\"Someone at \u003cdomain\u003e\u003c/domain\u003e already created a Free workspace. Joining is by invitation until an owner enables domain self-join.\",\"inviteOnlyHelp\":\"Ask your company's workspace owner or admin to invite your email address from the Members page. Accept the invitation, then come back here. You don't need another workspace or an upgrade.\"},\"invite\":{\"goToPlatform\":\"Go to Kite Platform\",\"notFound\":\"Invitation not found\",\"notFoundDescription\":\"The link may be mistyped, or the invitation was deleted. Ask for a new one.\",\"used\":\"Invitation already used\",\"usedDescription\":\"If you accepted it, you'll find \u003corganization\u003e\u003c/organization\u003e in your organizations after signing in.\",\"expired\":\"Invitation expired\",\"withdrawn\":\"Invitation withdrawn\",\"inviteAgain\":\"Ask \u003cinviter\u003e\u003c/inviter\u003e of \u003corganization\u003e\u003c/organization\u003e to invite you again.\",\"ownerOrAdmin\":\"an owner or admin\",\"someone\":\"Someone\",\"join\":\"Join \u003corganization\u003e\u003c/organization\u003e\",\"description\":\"\u003cinviter\u003e\u003c/inviter\u003e invited \u003cemail\u003e\u003c/email\u003e to join as {role}.\",\"roles\":{\"owner\":\"an owner\",\"admin\":\"an admin\",\"member\":\"a